<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- SolPlugs=1 when package.ps1 staged the SolPlugs (SolPlugsDir holds VST3\ and CLAP\). -->
  <?ifndef SolPlugs?>
  <?define SolPlugs = 0?>
  <?endif?>
  <Package Name="Solara" Manufacturer="Zee Creations LLC" Version="$(var.Version)" UpgradeCode="9A433B22-0986-44D8-AB8A-3AD549F94686" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Solara digital audio workstation" Manufacturer="Zee Creations LLC" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Solara is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SolaraIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SolaraIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/arpeggi5150/Solara" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/arpeggi5150/Solara/releases" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Zee Creations">
        <Directory Id="INSTALLFOLDER" Name="Solara" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Solara" Level="1">
      <ComponentGroupRef Id="SoundcraftFiles" />
    </Feature>
<?if $(var.SolPlugs) = 1 ?>
    <!-- "Install SolPlugs?": every SolPlug as a native VST3 and CLAP plugin, in the folders every DAW
         scans (Common Files for everyone; %LOCALAPPDATA%\Programs\Common for Only for me), so they
         work in Reaper and other DAWs too. Solara's package browser updates them one by one later.
         Silent installs take them unless INSTALL_SOLPLUGS=0. -->
    <Property Id="INSTALL_SOLPLUGS" Value="1" Secure="yes" />
    <Feature Id="SolPlugs" Title="SolPlugs" Description="VST3 and CLAP plugins for Solara, Reaper and other DAWs" Level="1" AllowAbsent="yes">
      <Level Value="0" Condition="INSTALL_SOLPLUGS = &quot;0&quot;" />
      <ComponentGroupRef Id="SolPlugsFiles" />
    </Feature>
    <StandardDirectory Id="CommonFiles64Folder">
      <Directory Id="SOLPLUGSROOT" Name=".">
        <Directory Id="SOLPLUGSVST3" Name="VST3" />
        <Directory Id="SOLPLUGSCLAP" Name="CLAP" />
      </Directory>
    </StandardDirectory>
    <!-- Only for me: this account's plugin folder, which needs no administrator. -->
    <SetProperty Id="SOLPLUGSROOT" Action="SolPlugsUserRoot" Value="[LocalAppDataFolder]Programs\Common\" Before="CostFinalize" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" />
    <UI>
      <Dialog Id="SolPlugsDlg" Width="370" Height="220" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="30" Text="{\CraftScopeTitle}Install SolPlugs?" />
        <Control Id="Info" Type="Text" X="20" Y="50" Width="330" Height="90" Text="{\CraftScopeText}SolPlugs are the plugins that come with Solara: $(var.SolPlugsNames).&#xD;&#xA;&#xD;&#xA;They install as VST3 and CLAP plugins, so they work in Reaper and other DAWs too, not just in Solara. You can add, update or remove them later in Solara: Window &gt; SolPlugs Packages." />
        <Control Id="Yes" Type="PushButton" X="144" Y="182" Width="66" Height="20" Default="yes" Text="Yes">
          <Publish Property="INSTALL_SOLPLUGS" Value="1" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="No" Type="PushButton" X="214" Y="182" Width="66" Height="20" Text="No">
          <Publish Property="INSTALL_SOLPLUGS" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="290" Y="182" Width="60" Height="20" Cancel="yes" Text="Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="SolPlugsDlg" After="CraftScopeDlg" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
    </InstallUISequence>
<?endif?>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="SoundcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="SoundcraftNotice">
        <File Id="SoundcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="SoundcraftApp" Guid="8AFE8671-9BE6-40F4-9E8A-C8E10A74E61D">
        <File Id="SoundcraftExe" Source="$(var.BinDir)\solara.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Solara" Description="Solara digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="SolaraIcon.ico" IconIndex="0" />
        </File>

        <!-- .scraft: Solara's own session format; Solara is its default app. -->
        <ProgId Id="Solara.Session" Description="Solara Session" Icon="SoundcraftExe" IconIndex="0">
          <Extension Id="scraft" ContentType="application/x-soundcraft-session">
            <Verb Id="open" Command="Open" TargetFile="SoundcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="Solara.Audio" Description="Audio File" Icon="SoundcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Solara.Audio\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Solara.Midi" Description="MIDI File" Icon="SoundcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Solara.Midi\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.wav\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.aif\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.aiff\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.flac\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mp3\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mid\OpenWithProgids" Name="Solara.Midi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.midi\OpenWithProgids" Name="Solara.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "solara"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe" Name="FriendlyAppName" Value="Solara" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".scraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solara.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\solara.exe" Value="[#SoundcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Solara" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="SoundcraftCli" Guid="55B03A61-2019-4A1B-B0BD-2C5D1D44EA78">
        <File Id="SoundcraftCliExe" Source="$(var.BinDir)\solara-cli.exe" KeyPath="yes" />
      </Component>

      <!-- The standalone updater: swaps in a delta update after Solara has quit. -->
      <Component Id="SolaraUpdater">
        <File Id="SolaraUpdaterExe" Source="$(var.BinDir)\solara-updater.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
<?if $(var.SolPlugs) = 1 ?>
  <Fragment>
    <ComponentGroup Id="SolPlugsFiles">
      <Files Directory="SOLPLUGSVST3" Include="$(var.SolPlugsDir)\VST3\**" />
      <Files Directory="SOLPLUGSCLAP" Include="$(var.SolPlugsDir)\CLAP\**" />
    </ComponentGroup>
  </Fragment>
<?endif?>
</Wix>

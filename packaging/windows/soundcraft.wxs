<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Solara" Manufacturer="Zee Creations LLC" Version="$(var.Version)" UpgradeCode="9A433B22-0986-44D8-AB8A-3AD549F94686" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Solara digital audio workstation" Manufacturer="Zee Creations LLC" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Solara is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SoundcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SoundcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/arpeggi5150/Solara" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/arpeggi5150/Solara/releases" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Zee Creations">
        <Directory Id="INSTALLFOLDER" Name="Solara" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Solara" Level="1">
      <ComponentGroupRef Id="SoundcraftFiles" />
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="SoundcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="SoundcraftNotice">
        <File Id="SoundcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="SoundcraftApp" Guid="8AFE8671-9BE6-40F4-9E8A-C8E10A74E61D">
        <File Id="SoundcraftExe" Source="$(var.BinDir)\soundcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Solara" Description="Solara digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="SoundcraftIcon.ico" IconIndex="0" />
        </File>

        <!-- .scraft: Solara's own session format; Solara is its default app. -->
        <ProgId Id="Solara.Session" Description="Solara Session" Icon="SoundcraftExe" IconIndex="0">
          <Extension Id="scraft" ContentType="application/x-soundcraft-session">
            <Verb Id="open" Command="Open" TargetFile="SoundcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="Solara.Audio" Description="Audio File" Icon="SoundcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Solara.Audio\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Solara.Midi" Description="MIDI File" Icon="SoundcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Solara.Midi\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.wav\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.aif\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.aiff\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.flac\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mp3\OpenWithProgids" Name="Solara.Audio" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mid\OpenWithProgids" Name="Solara.Midi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.midi\OpenWithProgids" Name="Solara.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "soundcraft"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe" Name="FriendlyAppName" Value="Solara" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".scraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\soundcraft.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\soundcraft.exe" Value="[#SoundcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Solara" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="SoundcraftCli" Guid="55B03A61-2019-4A1B-B0BD-2C5D1D44EA78">
        <File Id="SoundcraftCliExe" Source="$(var.BinDir)\soundcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
